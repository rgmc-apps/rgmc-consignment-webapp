# Dev proxy target — Vite rewrites /bc/* to this URL when VITE_API_BASE_URL is empty
BC_API_PROXY_TARGET=https://rgmc-bc-api-prod-935246372408.asia-southeast1.run.app

# When set, axios uses this as baseURL for all /bc/* calls (bypasses Vite proxy, CORS required on API)
VITE_API_BASE_URL=https://rgmc-bc-api-prod-935246372408.asia-southeast1.run.app

# Gateway portal base URL — used for the report-a-bug link
VITE_GATEWAY_URL=https://rgmc-gateway-935246372408.asia-southeast1.run.app
